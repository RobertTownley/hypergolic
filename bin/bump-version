#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ] || [[ ! "$1" =~ ^(patch|minor)$ ]]; then
    echo "Usage: bin/bump-version <patch|minor>"
    exit 1
fi

BUMP_TYPE="$1"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

CURRENT=$(grep '^version' "$ROOT/pyproject.toml" | head -1 | sed 's/.*"\(.*\)"/\1/')
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

if [ "$BUMP_TYPE" = "minor" ]; then
    MINOR=$((MINOR + 1))
    PATCH=0
else
    PATCH=$((PATCH + 1))
fi

NEW="${MAJOR}.${MINOR}.${PATCH}"

# pyproject.toml
sed -i '' "s/^version = \".*\"/version = \"${NEW}\"/" "$ROOT/pyproject.toml"

# ui/package.json
sed -i '' "s/\"version\": \".*\"/\"version\": \"${NEW}\"/" "$ROOT/ui/package.json"

# api.py
sed -i '' "s/version=\".*\"/version=\"${NEW}\"/" "$ROOT/hypergolic/api.py"

echo "Bumped version: ${CURRENT} → ${NEW}"
